{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oceanpolicy-v2",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"binding": "ASSETS", "directory": "./dist/client"},
  "observability": {"enabled": false}
}

